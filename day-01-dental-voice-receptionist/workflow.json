                  {
                      "id":  "7b9d9d2a-c9a1-4ee2-b34e-0a1cb3647192",
                      "name":  "Triage \u0026 Parse Lead",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       720,
                                       240
                                   ],
                      "parameters":  {
                                         "jsCode":  "const body = $input.first().json.body || {};\nconst message = body.message || {};\nconst toolCall = (message.toolCalls \u0026\u0026 message.toolCalls[0]) || {};\nlet args = (toolCall.function \u0026\u0026 toolCall.function.arguments) || {};\n\nif (typeof args === \u0027string\u0027) {\n  try {\n    args = JSON.parse(args);\n  } catch (e) {\n    args = {};\n  }\n}\n\n// Extract ONLY USER messages (never system prompt or assistant messages)\nlet userMsgs = [];\nif (Array.isArray(message.conversation)) {\n  userMsgs = message.conversation.filter(m =\u003e m.role === \u0027user\u0027).map(m =\u003e m.content || m.message || \u0027\u0027);\n} else if (message.artifact \u0026\u0026 Array.isArray(message.artifact.messages)) {\n  userMsgs = message.artifact.messages.filter(m =\u003e m.role === \u0027user\u0027).map(m =\u003e m.message || m.content || \u0027\u0027);\n}\nconst userText = userMsgs.join(\u0027 \u0027);\n\n// 1. Patient Name: prioritize args, then user dialogue\nlet patientName = args.patientName || args.name || \u0027\u0027;\nif (!patientName \u0026\u0026 userText) {\n  const nameMatch = userText.match(/(?:my name is|name is|call me|i\u0027m|this is)\\s+([a-zA-Z]+)/i);\n  if (nameMatch) {\n    patientName = nameMatch[1].trim();\n  }\n}\npatientName = patientName || \u0027Patient\u0027;\n\n// 2. Phone Number: prioritize args, then user dialogue\nlet phone = args.phone || args.phoneNumber || \u0027\u0027;\nif (!phone \u0026\u0026 userText) {\n  const phoneMatch = userText.match(/(?:phone(?: number)?(?: is)?|number(?: is)?)\\s*[:\\s]*([\\d\\s.-]{7,25})/i);\n  if (phoneMatch) {\n    phone = phoneMatch[1].replace(/[\\s.-]/g, \u0027\u0027);\n  } else {\n    const digitsMatch = userText.match(/(?:\\+?\\d[\\d\\s.-]{6,20})/);\n    if (digitsMatch) {\n      phone = digitsMatch[0].replace(/[\\s.-]/g, \u0027\u0027);\n    }\n  }\n}\nphone = phone || \u0027Not provided\u0027;\n\n// 3. Time: prioritize args, then detect from user speech\nlet preferredDate = args.preferredDate || args.date || \u0027\u0027;\nlet preferredTime = args.preferredTime || args.time || \u0027\u0027;\nif (!preferredTime \u0026\u0026 userText) {\n  if (/afternoon/i.test(userText)) preferredTime = \u0027Afternoon\u0027;\n  else if (/morning/i.test(userText)) preferredTime = \u0027Morning\u0027;\n  else if (/evening/i.test(userText)) preferredTime = \u0027Evening\u0027;\n  else preferredTime = \u0027Flexible\u0027;\n}\nif (!preferredDate) {\n  if (/tomorrow/i.test(userText)) preferredDate = \u0027Tomorrow\u0027;\n  else if (/today/i.test(userText)) preferredDate = \u0027Today\u0027;\n  else preferredDate = \u0027Earliest Available\u0027;\n}\n\n// 4. Service \u0026 Emergency Triage\nconst isEmergency = /pain|emergency|bleeding|swelling|broken|ache|severe|trauma/i.test(userText + \u0027 \u0027 + (args.service || \u0027\u0027) + \u0027 \u0027 + (args.notes || \u0027\u0027));\nlet service = args.service || args.reason || \u0027\u0027;\nif (!service) {\n  if (isEmergency) service = \u0027Emergency Toothache / Care\u0027;\n  else if (/cleaning|whitening/i.test(userText)) service = \u0027Routine Cleaning \u0026 Whitening\u0027;\n  else service = \u0027Routine Consultation / Checkup\u0027;\n}\n\nconst triageStatus = isEmergency ? \u0027HIGH PRIORITY / EMERGENCY\u0027 : \u0027STANDARD / ROUTINE\u0027;\nconst notes = args.notes || (isEmergency ? \u0027Reported tooth pain during call\u0027 : \u0027Normal routine checkup\u0027);\n\nconst safePhone = String(phone).startsWith(\u0027+\u0027) ? `\u0027${phone}` : String(phone);\n\nreturn {\n  json: {\n    \u0027TIMESTAMP\u0027: new Date().toLocaleString(),\n    \u0027PATIENT NAME\u0027: patientName,\n    \u0027PHONE NUMBER\u0027: safePhone,\n    \u0027SERVICE / REASON\u0027: service,\n    \u0027PREFERRED TIME\u0027: `${preferredDate} ${preferredTime}`.trim(),\n    \u0027TRIAGE STATUS\u0027: triageStatus,\n    \u0027NOTES\u0027: notes\n  }\n};"
                                     }
                  },
                  {
                      "id":  "a8b1c2d3-e4f5-4a6b-8c9d-0e1f2a3b4c5d",
                      "name":  "Respond to Vapi Voicebot",
                      "type":  "n8n-nodes-base.respondToWebhook",
                      "typeVersion":  1.5,
