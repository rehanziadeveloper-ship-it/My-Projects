                                         "jsCode":  "const body = $input.first().json.body || {};\nconst message = body.message || {};\n\nreturn {\n  json: {\n    callId: message.call?.id || \u0027unknown\u0027,\n    endedReason: message.endedReason || \u0027normal\u0027,\n    durationSeconds: message.durationSeconds || message.duration || 0,\n    cost: message.cost || 0,\n    summary: message.summary || \u0027No summary provided\u0027,\n    transcript: message.transcript || \u0027No transcript\u0027,\n    recordingUrl: message.recordingUrl || message.stereoRecordingUrl || null,\n    receivedAt: new Date().toISOString()\n  }\n};"
